// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
  ANALYST
}

enum ContentStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  SPAM
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           Role      @default(VIEWER)
  isActive       Boolean   @default(true)
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  articles  Article[]
  audits    AuditLog[]
  messages  ContactMessage[] @relation("MessageHandler")
  uploads   Media[]          @relation("MediaUploader")
  revisions Revision[]       @relation("RevisionAuthor")

  @@index([role, isActive])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles Article[]

  @@index([sortOrder])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[] @relation("ArticleTags")
}

model Article {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String
  content        Json
  coverId        String?
  coverAlt       String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  scheduledAt    DateTime?
  seoTitle       String?
  seoDescription String?
  authorId       String
  categoryId     String
  readingTime    Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  author      User             @relation(fields: [authorId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  cover       Media?           @relation(fields: [coverId], references: [id], onDelete: Restrict)
  tags        Tag[]            @relation("ArticleTags")
  relatedFrom ArticleRelated[] @relation("ArticleRelated")
  relatedTo   ArticleRelated[] @relation("RelatedToArticle")

  @@index([status, publishedAt])
  @@index([status, scheduledAt])
  @@index([categoryId, status])
  @@index([deletedAt])
}

model ArticleRelated {
  articleId String
  relatedId String
  sortOrder Int    @default(0)

  article Article @relation("ArticleRelated", fields: [articleId], references: [id], onDelete: Cascade)
  related Article @relation("RelatedToArticle", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([articleId, relatedId])
  @@index([relatedId])
}

model Portfolio {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  category     String
  clientSector String
  summary      String
  description  Json
  tech         String[]
  impact       String
  metric       String?
  imageId      String?
  imageAlt     String?
  sortOrder    Int           @default(0)
  featured     Boolean       @default(false)
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  scheduledAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  image Media? @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@index([status, sortOrder])
  @@index([status, scheduledAt])
}

model Service {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  category    String
  shortDesc   String
  description Json
  features    String[]
  icon        String
  ctaLabel    String
  ctaHref     String
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([status, sortOrder])
  @@index([status, scheduledAt])
}

model PricingPlan {
  id          String        @id @default(cuid())
  name        String
  priceLabel  String
  priceNote   String?
  description String
  features    String[]
  badge       String?
  ctaLabel    String
  ctaHref     String
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([status, sortOrder])
  @@index([status, scheduledAt])
}

model Faq {
  id          String        @id @default(cuid())
  question    String
  answer      String
  category    String?
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([status, sortOrder])
  @@index([status, scheduledAt])
}

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  content        Json
  seoTitle       String?
  seoDescription String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  scheduledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([status])
  @@index([status, scheduledAt])
}

model Media {
  id           String    @id @default(cuid())
  key          String    @unique
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  decorative   Boolean   @default(false)
  variants     Json?
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  articles   Article[]
  portfolios Portfolio[]
  usages     MediaUsage[]

  uploadedBy User? @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([deletedAt])
}

model MediaUsage {
  mediaId    String
  entityType String
  entityId   String
  field      String

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([mediaId, entityType, entityId, field])
  @@index([entityType, entityId])
}

model Revision {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  snapshot    Json
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation("RevisionAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id           String        @id @default(cuid())
  name         String
  email        String
  service      String?
  message      String
  sourcePage   String
  status       MessageStatus @default(NEW)
  internalNote String?
  handledById  String?
  ipHash       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  handledBy User? @relation("MessageHandler", fields: [handledById], references: [id])

  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  summary    Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique
  to        String
  status    Int      @default(301)
  createdAt DateTime @default(now())
}

model JobRun {
  id           String    @id @default(cuid())
  name         String
  status       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  message      String?
  rowsAffected Int?

  @@index([name, startedAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model AnalyticsEvent {
  id         BigInt   @id @default(autoincrement())
  eventName  String
  path       String
  referrer   String?
  source     String?
  medium     String?
  campaign   String?
  device     String?
  browser    String?
  country    String?
  city       String?
  visitorId  String
  sessionId  String
  metadata   Json?
  occurredAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([occurredAt])
  @@index([eventName, occurredAt])
  @@index([path, occurredAt])
  @@index([visitorId, occurredAt])
}

model AnalyticsDaily {
  id          BigInt   @id @default(autoincrement())
  date        DateTime @db.Date
  path        String
  eventName   String
  source      String   @default("direct")
  device      String   @default("unknown")
  pageviews   Int      @default(0)
  visitors    Int      @default(0)
  sessions    Int      @default(0)
  bounces     Int      @default(0)
  durationSec Int      @default(0)
  conversions Int      @default(0)

  @@unique([date, path, eventName, source, device])
  @@index([date])
}

model AnalyticsMonthly {
  id          BigInt   @id @default(autoincrement())
  month       DateTime @db.Date
  path        String
  pageviews   Int      @default(0)
  visitors    Int      @default(0)
  conversions Int      @default(0)

  @@unique([month, path])
}
