# ========================================================
# ENVIRONMENT VARIABLES TEMPLATE - NAYKON DIGITAL
# ========================================================
# Kredensial di bawah ini otomatis disediakan oleh Vercel Postgres / Neon.
# Cukup salin dari tab Storage > Postgres > .env.local di Vercel Dashboard,
# lalu tempel ke file .env.local di proyek ini.
# ========================================================

# 1. KREDENSIAL VERCEL POSTGRES / NEON
# --------------------------------------------------------
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-sample.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

PGHOST="ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech"
PGHOST_UNPOOLED="ep-sample.c-2.ap-southeast-1.aws.neon.tech"
PGUSER="neondb_owner"
PGDATABASE="neondb"
PGPASSWORD="password"

POSTGRES_URL="postgresql://neondb_owner:password@ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://neondb_owner:password@ep-sample.c-2.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
POSTGRES_USER="neondb_owner"
POSTGRES_HOST="ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech"
POSTGRES_PASSWORD="password"
POSTGRES_DATABASE="neondb"
POSTGRES_URL_NO_SSL="postgresql://neondb_owner:password@ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb"
POSTGRES_PRISMA_URL="postgresql://neondb_owner:password@ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&connect_timeout=15&sslmode=require"

# 2. AUTENTIKASI CMS (NextAuth / Auth.js)
# --------------------------------------------------------
AUTH_SECRET="generate_random_secret_key_minimum_32_characters"
NEXTAUTH_URL="http://localhost:3000"

# 3. PENYIMPANAN MEDIA (Cloudflare R2 Object Storage)
# --------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="naykon-media"
R2_PUBLIC_URL=""

# 4. EMAIL & NOTIFIKASI (Resend / SMTP)
# --------------------------------------------------------
RESEND_API_KEY=""
ADMIN_NOTIFICATION_EMAIL="admin@naykon.id"
